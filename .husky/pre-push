# Run the estate's own CI before anything leaves this machine.
#
# The gate below used to be a hub typecheck, for a reason that is worth keeping:
# 81c61b3 deleted apps/hub/src/lib/theme.ts and two siblings while three files
# still imported them, was pushed STRAIGHT TO main, and CI reported after the
# fact — racing a production deploy that failed the same way. A `push:` workflow
# reports; it cannot block.
#
# WHAT CHANGED, 2026-09-04. That reasoning ended "and CI already covers it", and
# twice now it has not. A prerender error reached main on 2026-08-23 and served a
# four-hour-old build, because only `next build` sees that class. And on
# 2026-09-04 GitHub Actions stopped assigning runners entirely — every workflow
# died in three seconds with `runner=""`, so for a stretch of the evening NOTHING
# was enforced anywhere while pull requests still showed ticks.
#
# So the local runner is no longer a convenience. `npm run ci` executes the same
# steps as .github/workflows/*.yml, derived FROM those files rather than copied,
# plus the case audit that ubuntu gets for free and macOS cannot.
#
# COST IS THE WHOLE DESIGN. A hook people bypass is worse than no hook, because it
# manufactures the belief that something was checked. So:
#
#   pushing to main      → `npm run ci`      the full suite, several minutes
#   pushing anywhere else → a fast subset     seconds, and it catches the two
#                                             things a branch push actually gets
#                                             wrong: a broken type and a wrongly
#                                             cased import
#
# Before opening or merging a PR, run `npm run ci` yourself. While Actions is
# unavailable, that is the only thing standing between a branch and main.
#
# Genuinely need to bypass: `git push --no-verify`. It is there deliberately, and
# it is the reason this is not a gate — only a required status check is.

pushing_to_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main) pushing_to_main=1 ;;
  esac
done

if [ "$pushing_to_main" -eq 1 ]; then
  echo "pre-push: main — running the full local CI (npm run ci)…"
  if ! npm run ci --silent; then
    echo ""
    echo "✖ pre-push: local CI failed — not pushing to main."
    echo "  This is what reaches production, so it fails here rather than in the deploy."
    echo "  Fix it, or bypass deliberately with: git push --no-verify"
    exit 1
  fi
  exit 0
fi

# Feature branch: seconds, not minutes. A wrongly cased import resolves on this
# filesystem and fails on the Linux runner, so it is worth the half second even
# on a branch nobody will merge today.
echo "pre-push: quick checks (case audit + hub typecheck)…"
if ! npm run check:case --silent; then
  echo ""
  echo "✖ pre-push: an import does not match the real spelling on disk."
  echo "  macOS resolves it; Linux will not. Fix it, or: git push --no-verify"
  exit 1
fi
if ! npm run check:hub --silent; then
  echo ""
  echo "✖ pre-push: the hub does not typecheck."
  echo "  Run \`npm run ci\` for the full suite. Bypass with: git push --no-verify"
  exit 1
fi
