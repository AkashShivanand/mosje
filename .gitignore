# Dependencies
node_modules/

# Local git-history backups of absorbed sub-repos (dosje, smile-admin)
/_backups/

# Raw source material — never commit (21 GB of drops)
/Incoming/

# Large binary design exports — keep in Figma / Git LFS, not here
/Designs/

# Build outputs & caches (apps now live under apps/ and are tracked)
**/.next/
**/out/
**/storybook-static/
# Storybook is built into the hub's static output at deploy time (see the hub's
# prebuild script) — generated, never committed.
apps/hub/public/storybook/
*.tsbuildinfo
.turbo/

# Playwright E2E artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Secrets & local environment
.env
.env.*
!.env.example
*.pem
*.key
secrets*

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# graphify knowledge-graph output (per-project, do not commit)
graphify-out/
.graphify_*
# superpowers plugin scratch/brainstorm cache (tool working dir, not project code)
.superpowers/
.qc/
docs/qc/portals/eutthan-admin/.qc/
docs/qc/portals/eutthan-admin/_archive/

# Design-audit QC report figures — large PNGs (~32 MB), not needed at runtime (PERF-007)
# Already committed files remain in history; new additions to this dir are blocked.
apps/hub/public/reports/eutthan-admin/figures/
.gstack/

.vercel
.env*

# One-off scratch scripts at the repo root.
#
# Nine of these reached main during the docs work — fix_tabs.py, migrate_all.py,
# transform.py, four numbered test-css*.mjs and a test-color.js that required a
# puppeteer the repo does not even depend on. All unreferenced, none runnable.
# Codemods worth keeping belong in scripts/ or tools/ with a name that says what
# they do; anything genuinely throwaway belongs in a scratch directory outside
# the repo. This pattern only covers the ROOT, so scripts/ and tools/ are
# unaffected.
/fix_*.py
/fix_*.mjs
/migrate_*.py
/migrate_*.mjs
/transform.py
/test-*.js
/test-*.mjs
/test-*.py
# Added 2026-08-24. The first pass named the nine files that existed and missed
# the naming everyone actually reaches for: `patch`. Two more — patch-intro.mjs
# and patch-docs-layout.mjs — were committed to main within the week, and seven
# others (patch.mjs, patch2.mjs, patch_mega.mjs, revert_nav_parts.mjs and
# friends) were sitting uncommitted in the tree waiting their turn. Match the
# VERB, both separators, not one spelling of it.
/patch*.mjs
/patch*.js
/patch*.py
/revert*.mjs
/revert*.js
/revert*.py
