# graphify knowledge-graph output (per-project, do not commit)
graphify-out/
.graphify_*
# superpowers plugin scratch/brainstorm cache (tool working dir, not project code)
.superpowers/
.qc/
docs/qc/portals/eutthan-admin/.qc/
docs/qc/portals/eutthan-admin/_archive/

# Design-audit QC report figures — large PNGs (~32 MB), not needed at runtime (PERF-007)
# Already committed files remain in history; new additions to this dir are blocked.
apps/hub/public/reports/eutthan-admin/figures/
.gstack/

.vercel
.env*

# Loose scripts at the repo root — ALLOWLIST, not a list of verbs.
#
# This block chased naming for three rounds and lost every time: it named
# fix_/migrate_/transform/test-, then patch/revert after two of those reached
# main, and `pm_ajay_extract.py` still walked past both. The verb is not
# predictable, so the rule stopped guessing it.
#
# Everything loose at the root is ignored; the two real configs are named back
# in. Both are already tracked, and .gitignore does not untrack anything, so
# they are safe either way — the exceptions are here so the intent survives a
# fresh clone. Nothing under scripts/ or tools/ is affected: these patterns are
# root-anchored, which is where throwaway lands and where a codemod worth
# keeping never should.
/*.py
/*.mjs
/*.js
/*.cjs
!/.lintstagedrc.mjs
!/.stylelintrc.js
