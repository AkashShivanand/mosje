  "shadow": {
    "$description": "Elevation ramp. none→xl is a 6-level superset of UX4G 3.0's 5-level l0…l4, and keeps the SAMAVESH convention of tinting toward ink (rgba(31,36,40,·)) rather than UX4G's flat black — tinted shadows read as depth instead of dirt on a light gov surface. sm/md fill the gap that previously jumped xs→lg.",
    "$type": "shadow",
    "none": {
      "$value": "none"
    },
    "xs": {
      "$value": "0 2px 3px 1px rgba(31, 36, 40, 0.12)"
    },
    "sm": {
      "$value": "0 4px 6px -1px rgba(31, 36, 40, 0.10), 0 2px 4px -2px rgba(31, 36, 40, 0.06)"
    },
    "md": {
      "$value": "0 8px 12px -3px rgba(31, 36, 40, 0.09), 0 3px 5px -2px rgba(31, 36, 40, 0.05)"
    },
    "lg": {
      "$value": "0 12px 16px -4px rgba(31, 36, 40, 0.08), 0 4px 6px -2px rgba(31, 36, 40, 0.03)"
    },
    "xl": {
      "$value": "0 24px 48px -12px rgba(31, 36, 40, 0.18)"
    }
  },
  "motion": {
    "$description": "Duration + easing primitives for transitions and animations.",
    "duration": {
      "fast": {
        "$value": "150ms"
      },
      "base": {
        "$value": "250ms"
      },
      "slow": {
        "$value": "400ms"
      }
    },
    "easing": {
      "out": {
        "$value": "cubic-bezier(0, 0, 0.2, 1)"
      },
      "in": {
        "$value": "cubic-bezier(0.4, 0, 1, 1)"
      },
      "inOut": {
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)"
      }
    }
  }
}
