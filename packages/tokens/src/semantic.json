{
  "$description": "Tier 2 — semantic/alias tokens. The PUBLIC contract apps consume.",
  "color": {
    "$type": "color",
    "action": {
      "primary": {
        "default": {"$value":"{color.primaryRamp.light.500}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.500}"},"themes":{"dark":"{color.primaryRamp.light.400}"}}}},
        "hover":   {"$value":"{color.primaryRamp.light.700}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.700}"},"themes":{"dark":"{color.primaryRamp.light.300}"}}}},
        "tonal":   {"$value":"{color.primaryRamp.light.100}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.100}"},"themes":{"dark":"rgba(45, 132, 232, 0.18)"}}}}
      }
    },
    "primaryScale": {
      "$description": "Full mode-aware primary ramp (50–900). Consume via --ds-primary-50…900. Each step follows the active color mode.",
      "50":  {"$value":"{color.primaryRamp.light.50}",  "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.50}"}}}},
      "100": {"$value":"{color.primaryRamp.light.100}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.100}"}}}},
      "200": {"$value":"{color.primaryRamp.light.200}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.200}"}}}},
      "300": {"$value":"{color.primaryRamp.light.300}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.300}"}}}},
      "400": {"$value":"{color.primaryRamp.light.400}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.400}"}}}},
      "500": {"$value":"{color.primaryRamp.light.500}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.500}"}}}},
      "600": {"$value":"{color.primaryRamp.light.600}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.600}"}}}},
      "700": {"$value":"{color.primaryRamp.light.700}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.700}"}}}},
      "800": {"$value":"{color.primaryRamp.light.800}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.800}"}}}},
      "900": {"$value":"{color.primaryRamp.light.900}", "$extensions":{"mosje":{"colorModes":{"blue-dark":"{color.primaryRamp.dark.900}"}}}}
    },
    "text": {
      "default": {"$value":"{color.neutral.800}", "$extensions":{"mosje":{"themes":{"dark":"{color.a11y.dark.ink}","hc":"#000000"}}}},
      "muted":   {"$value":"{color.neutral.700}", "$extensions":{"mosje":{"themes":{"dark":"{color.a11y.dark.inkMuted}"}}}},
      "strong":  {"$value":"{color.neutral.900}", "$extensions":{"mosje":{"themes":{"dark":"{color.neutral.0}"}}}},
      "disabled": {"$value":"rgba(31, 36, 40, 0.48)", "$extensions":{"mosje":{"themes":{"dark":"rgba(243, 244, 246, 0.40)"}}}},
      "onPrimary": {"$value":"{color.neutral.0}"}
    },
    "bg": {
      "surface": {"$value":"{color.neutral.0}",  "$extensions":{"mosje":{"themes":{"dark":"{color.a11y.dark.surface}","hc":"#ffffff"}}}},
      "muted":   {"$value":"{color.neutral.50}", "$extensions":{"mosje":{"themes":{"dark":"{color.a11y.dark.bg}","hc":"#ffffff"}}}},
      "alt":     {"$value":"{color.neutral.75}", "$extensions":{"mosje":{"themes":{"dark":"{color.a11y.dark.surfaceMuted}"}}}}
    },
    "border": {
      "subtle": {"$value":"{color.neutral.100}", "$extensions":{"mosje":{"themes":{"dark":"#262b33","hc":"#000000"}}}},
      "strong": {"$value":"{color.neutral.200}", "$extensions":{"mosje":{"themes":{"dark":"{color.a11y.dark.border}","hc":"#000000"}}}},
      "control": {"$value":"{color.neutral.400}", "$extensions":{"mosje":{"themes":{"dark":"#4a5263","hc":"#000000"}}}},
      "controlHover": {"$value":"{color.neutral.500}", "$extensions":{"mosje":{"themes":{"dark":"#5b6577","hc":"#000000"}}}}
    },
    "focus": { "ring": {"$value":"rgba(3, 115, 223, 0.48)", "$extensions":{"mosje":{"colorModes":{"blue-dark":"rgba(0, 51, 102, 0.48)"},"themes":{"dark":"rgba(125, 180, 245, 0.55)"}}}} },
    "status": {
      "success": {"$value":"{color.green.500}", "$extensions":{"mosje":{"themes":{"dark":"#66bb6a"}}}},
      "successStrong": {"$value":"{color.green.700}", "$extensions":{"mosje":{"themes":{"dark":"#81c784"}}}},
      "successTonal": {"$value":"{color.green.50}", "$extensions":{"mosje":{"themes":{"dark":"rgba(102, 187, 106, 0.16)"}}}},
      "warning": {"$value":"{color.yellow.500}"},
      "warningTonal": {"$value":"{color.saffron.50}", "$extensions":{"mosje":{"themes":{"dark":"rgba(255, 211, 35, 0.16)"}}}},
      "danger":  {"$value":"{color.red.500}", "$extensions":{"mosje":{"themes":{"dark":"#ff6b5e"}}}},
      "dangerStrong": {"$value":"{color.red.700}", "$extensions":{"mosje":{"themes":{"dark":"#ff8a80"}}}},
      "dangerTonal": {"$value":"{color.red.50}", "$extensions":{"mosje":{"themes":{"dark":"rgba(255, 107, 94, 0.16)"}}}},
      "info":    {"$value":"{color.blue.500}", "$extensions":{"mosje":{"themes":{"dark":"#5fa0ef"}}}}
    },
    "overlay": {
      "scrim": {"$value":"rgba(33, 33, 33, 0.5)", "$extensions":{"mosje":{"themes":{"dark":"rgba(0, 0, 0, 0.6)"}}}}
    },
    "a11y": {
      "$description": "Accessibility-widget self-contained palettes (its own HC + dark toggles).",
      "hc": {
        "fg":    {"$value":"#000000"},
        "bg":    {"$value":"#ffffff"},
        "link":  {"$value":"#00006b"},
        "focus": {"$value":"#ffe600"}
      },
      "dark": {
        "bg":           {"$value":"#0f1115"},
        "ink":          {"$value":"#f3f4f6"},
        "inkMuted":     {"$value":"#c2c7d0"},
        "surface":      {"$value":"#1b1f27"},
        "surfaceMuted": {"$value":"#242a35"},
        "border":       {"$value":"#343b48"}
      }
    },
    "brand": {
      "saffron":     {"$value":"{color.saffron.500}"},
      "saffronLight":{"$value":"{color.saffron.50}"},
      "saffronDark": {"$value":"{color.saffron.700}"},
      "navy":        {"$value":"{color.navy.700}"},
      "yellow":      {"$value":"{color.yellow.500}"}
    }
  },
  "type": {
    "$description": "Named type roles → primitive size/leading/weight.",
    "display":  {"size":{"$type":"dimension","$value":"{font.size.900}"},"leading":{"$type":"dimension","$value":"{font.lineHeight.900}"},"weight":{"$type":"fontWeight","$value":"{font.weight.medium}"}},
    "title1":   {"size":{"$type":"dimension","$value":"{font.size.600}"},"leading":{"$type":"dimension","$value":"{font.lineHeight.400}"},"weight":{"$type":"fontWeight","$value":"{font.weight.medium}"}},
    "headline": {"size":{"$type":"dimension","$value":"{font.size.500}"},"leading":{"$type":"dimension","$value":"{font.lineHeight.300}"},"weight":{"$type":"fontWeight","$value":"{font.weight.semibold}"}},
    "body1":    {"size":{"$type":"dimension","$value":"{font.size.400}"},"leading":{"$type":"dimension","$value":"{font.lineHeight.300}"},"weight":{"$type":"fontWeight","$value":"{font.weight.regular}"}},
    "body2":    {"size":{"$type":"dimension","$value":"{font.size.300}"},"leading":{"$type":"dimension","$value":"{font.lineHeight.200}"},"weight":{"$type":"fontWeight","$value":"{font.weight.regular}"}}
  },
  "density": {
    "$description": "Density token set: control height per density mode.",
    "control": {
      "height": {"$type":"dimension","$value":"40px","$extensions":{"mosje":{"themes":{"compact":"32px"}}}}
    }
  }
}
