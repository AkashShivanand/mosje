{
  "name": "@mosje/design-system",
  "version": "0.5.0",
  "description": "Shared MoSJE UI components (17 atoms + form layer: Input/Textarea/Select/FormField) plus the color-mode brand-axis (ColorModeProvider/Switcher), aligned to the UX4G Figma DS. Token-driven — consumes the generated --ds-/--sa- contract from @mosje/tokens (do not edit tokens.css here; edit packages/tokens/src/*.json).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tokens": "./tokens.ts",
    "./tokens.css": "./tokens.css",
    "./components.css": "./components.css",
    "./color-mode": "./foundations/color-mode.ts",
    "./cn": "./utils/cn.ts"
  },
  "files": [
    "index.ts",
    "tokens.ts",
    "tokens.css",
    "components.css",
    "foundations",
    "utils",
    "components",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.6",
    "vitest": "^4.1.8"
  }
}
