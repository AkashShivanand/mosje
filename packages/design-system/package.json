{
  "name": "@mosje/design-system",
  "version": "0.6.0",
  "description": "Shared MoSJE UI components (atoms + form layer: Input/Textarea/Select/FormField/Label) plus the color-mode brand-axis (ColorModeProvider/Switcher), aligned to the UX4G Figma DS. Token-driven \u2014 consumes the generated --ds-/--sa- contract from @mosje/tokens (do not edit tokens.css here; edit packages/tokens/src/*.json).",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tokens": "./tokens.ts",
    "./tokens.css": "./tokens.css",
    "./ux4g.css": "./ux4g.css",
    "./components.css": "./components.css",
    "./layout.css": "./foundations/layout.css",
    "./icons.css": "./icons.css",
    "./color-mode": "./foundations/color-mode.ts",
    "./cn": "./utils/cn.ts",
    "./registry": "./components/navigation/registry-overrides.ts",
    "./app-registry": "./components/navigation/app-switcher-utils.ts",
    "./india-id": "./utils/india-id.ts"
  },
  "files": [
    "index.ts",
    "tokens.ts",
    "tokens.css",
    "components.css",
    "icons.css",
    "foundations",
    "utils",
    "components",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"utils/*.test.ts\" \"foundations/*.test.ts\" \"demo/*.test.ts\" \"components/**/*.test.ts\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^4.1.11",
    "d3-geo": "^3.1.1",
    "react": "^19",
    "react-dom": "^19",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0",
    "vitest": "^4.1.11"
  }
}
