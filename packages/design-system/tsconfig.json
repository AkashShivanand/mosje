{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Modules exercised by `node --test` must carry explicit .ts extensions,
    // because the bare Node runner does no extensionless ESM resolution. Safe
    // here because this project never emits (noEmit below) — the bundler
    // resolves the extension and Node resolves it literally.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["react", "react-dom"]
  },
  "include": ["index.ts", "tokens.ts", "components/**/*.ts", "components/**/*.tsx",
              "foundations/**/*.ts", "foundations/**/*.tsx",
              "demo/**/*.ts", "demo/**/*.tsx",
              "utils/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "node_modules"]
}
