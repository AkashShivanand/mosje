{
  "name": "mosje",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/portals/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky || true",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "kill-ports": "bash scripts/kill-dev-ports.sh",
    "predev": "npm run kill-ports && npm run ensure:storybook",
    "dev": "bash -c 'cd apps/hub && exec ./node_modules/.bin/next dev --turbopack -p 3007'",
    "branches": "bash scripts/branch-inventory.sh --text",
    "dev:hub": "bash -c 'cd apps/hub && exec ./node_modules/.bin/next dev --turbopack -p 3007'",
    "dev:storybook": "bash -c 'cd apps/storybook && exec env NODE_PATH=$(pwd)/node_modules ../../node_modules/.bin/storybook dev -p 6006'",
    "check:build": "npm --prefix apps/hub run build",
    "verify": "npm run lint && npm run lint:css && npm run check && npm run check:build",
    "check": "npm run check:hub && npm run check:hub-tests && npm run check:search-index && npm run check:docs-search && npm run check:dangling-vars && npm run check:docs-links && npm run check:website-links && npm run check:org-anchors && npm run check:docs-routes && npm run check:figma-docs && npm run check:docs-data && npm run check:ds-linkage && npm run check:type-linkage && npm run check:icon-scale && npm run check:space-linkage && npm run check:radius-linkage && npm run check:code-connect && npm run check:chart-slots && npm run check:chrome && npm run check:org-logos && npm run check:ds-pages && npm run check:props && npm run check:docs-coverage && npm run check:shadow-ui && npm run check:components-css && npm run check:storybook && npm run check:storybook:parity && npm run check:changelog && npm run check:design-context && npm run check:a11y-evidence && npm run check:chart-palette && npm run check:ds-lint",
    "check:docs-search": "node scripts/build-docs-search-index.mjs --check",
    "build:docs-search": "node scripts/build-docs-search-index.mjs",
    "check:changelog": "node scripts/check-changelog-freshness.mjs",
    "check:design-context": "node scripts/check-design-context.mjs",
    "check:design-context:baseline": "node scripts/check-design-context.mjs --update-baseline",
    "check:hub": "npm --prefix apps/hub run typecheck",
    "check:hub-tests": "npm --prefix apps/hub test",
    "lint": "npm run lint:hub",
    "lint:hub": "npm --prefix apps/hub run lint",
    "ux4g:measure": "node tools/ux4g-conformance/measure.mjs",
    "ux4g:report": "npm run build -w @mosje/tokens && node tools/ux4g-conformance/measure.mjs --write",
    "ux4g:extract": "node tools/ux4g-conformance/extract-ux4g-tokens.mjs",
    "test": "npm test -w @mosje/design-system && npm test --prefix apps/hub",
    "check:storybook": "node scripts/check-storybook-coverage.mjs",
    "check:storybook:parity": "node scripts/check-storybook-parity.mjs",
    "check:storybook:types": "npm --prefix apps/storybook run typecheck",
    "check:storybook:smoke": "node scripts/smoke-storybook.mjs",
    "check:storybook:baseline": "node scripts/check-storybook-coverage.mjs --update-baseline",
    "ensure:storybook": "node -e \"require('fs').existsSync('apps/hub/public/storybook/index.html')||(console.log('\u2022 building Storybook once into apps/hub/public/storybook\u2026'),process.exit(1))\" || npm run build:storybook --prefix apps/hub",
    "predev:hub": "npm run ensure:storybook",
    "check:docs-data": "node scripts/check-docs-data.mjs",
    "build:pmajay-standalone": "node tools/pmajay-standalone/build.mjs",
    "check:ds-linkage": "node tools/ds-linkage/check.mjs",
    "check:ds-linkage:all": "node tools/ds-linkage/check.mjs --all",
    "check:type-linkage": "node tools/type-linkage/check.mjs --gate",
    "check:type-linkage:report": "node tools/type-linkage/check.mjs",
    "check:type-linkage:baseline": "node tools/type-linkage/check.mjs --update-baseline",
    "check:space-linkage": "node --test packages/tokens/test/space-linkage.test.mjs",
    "check:space-linkage:baseline": "node packages/tokens/build/figma-space-audit.mjs --update-baseline",
    "check:icon-scale": "node tools/icon-audit/check.mjs --gate",
    "check:icon-scale:report": "node tools/icon-audit/check.mjs",
    "check:icon-scale:baseline": "node tools/icon-audit/check.mjs --update-baseline",
    "check:radius-linkage": "node --test packages/tokens/test/radius-linkage.test.mjs",
    "check:radius-linkage:baseline": "node packages/tokens/build/figma-radius-audit.mjs --update-baseline",
    "check:radius-linkage:report": "node packages/tokens/build/figma-radius-audit.mjs",
    "check:code-connect": "node tools/code-connect-parity/check.mjs",
    "check:dangling-vars": "node tools/dangling-vars/check.mjs",
    "check:docs-links": "node tools/docs-links/check.mjs",
    "check:website-links": "node tools/website-links/check.mjs",
    "check:figma-docs": "node tools/figma-doc-parity/check.mjs",
    "check:figma-docs:live": "node tools/figma-doc-parity/check.mjs --verify-figma",
    "check:figma-docs:sync": "node tools/figma-doc-parity/check.mjs --verify-figma --sync",
    "figma:connect": "figma connect publish",
    "figma:connect:check": "figma connect publish --dry-run --exit-on-unreadable-files",
    "lint:css": "stylelint '**/*.css'",
    "check:chrome": "node tools/chrome-single-source/check.mjs",
    "check:docs-routes": "node scripts/check-docs-routes.mjs",
    "check:search-index": "node scripts/build-search-index.mjs --check",
    "build:search-index": "node scripts/build-search-index.mjs",
    "check:chart-slots": "node tools/chart-slot-order/check.mjs",
    "check:org-anchors": "node tools/org-anchors/check.mjs",
    "check:feed-drift": "node tools/feed-drift/check.mjs",
    "check:ds-pages": "node tools/ds-page-standard/check.mjs",
    "check:ds-pages:baseline": "node tools/ds-page-standard/check.mjs --baseline",
    "check:ds-pages:report": "node tools/ds-page-standard/check.mjs --report",
    "snapshot:pmajay-map": "node scripts/build-pmajay-map-snapshot.mjs",
    "snapshot:pmajay-map:check": "node scripts/build-pmajay-map-snapshot.mjs --check",
    "check:org-logos": "node tools/org-logo/check.mjs",
    "check:org-logos:baseline": "node tools/org-logo/check.mjs --baseline",
    "check:org-logos:report": "node tools/org-logo/check.mjs --report",
    "build:props": "node tools/props-extract/extract.mjs",
    "check:props": "node tools/props-extract/extract.mjs --check",
    "check:docs-coverage": "node tools/docs-coverage/check.mjs",
    "check:docs-coverage:baseline": "node tools/docs-coverage/check.mjs --baseline",
    "check:shadow-ui": "node tools/shadow-ui/check.mjs",
    "check:shadow-ui:baseline": "node tools/shadow-ui/check.mjs --baseline",
    "build:components-css": "node scripts/build-components-css.mjs",
    "check:components-css": "node scripts/build-components-css.mjs --check",
    "check:a11y-evidence": "node tools/a11y-evidence/check.mjs",
    "check:chart-palette": "node tools/chart-palette/check.mjs",
    "check:chart-palette:report": "node tools/chart-palette/check.mjs --report",
    "check:chart-palette:baseline": "node tools/chart-palette/check.mjs --baseline",
    "check:a11y-evidence:baseline": "node tools/a11y-evidence/check.mjs --baseline",
    "check:a11y-evidence:report": "node tools/a11y-evidence/check.mjs --report",
    "test:a11y": "playwright test e2e/a11y",
    "check:ds-lint": "node tools/ds-lint/check.mjs",
    "check:ds-lint:baseline": "node tools/ds-lint/check.mjs --baseline"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.3.0"
  }
}
