{
  "name": "mosje",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/portals/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky || true",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "kill-ports": "bash scripts/kill-dev-ports.sh",
    "predev": "npm run kill-ports && npm run ensure:storybook",
    "dev": "bash -c 'cd apps/hub && exec ./node_modules/.bin/next dev --turbopack -p 3007'",
    "dev:hub": "bash -c 'cd apps/hub && exec ./node_modules/.bin/next dev --turbopack -p 3007'",
    "dev:storybook": "bash -c 'cd apps/storybook && exec env NODE_PATH=$(pwd)/node_modules ../../node_modules/.bin/storybook dev -p 6006'",
    "check": "npm run check:hub && npm run check:color-docs",
    "check:changelog": "node scripts/check-changelog-freshness.mjs",
    "check:design-context": "node scripts/check-design-context.mjs",
    "check:design-context:baseline": "node scripts/check-design-context.mjs --update-baseline",
    "check:hub": "npm --prefix apps/hub run typecheck",
    "lint": "npm run lint:hub",
    "lint:hub": "npm --prefix apps/hub run lint",
    "ux4g:measure": "node tools/ux4g-conformance/measure.mjs",
    "ux4g:report": "npm run build -w @mosje/tokens && node tools/ux4g-conformance/measure.mjs --write",
    "ux4g:extract": "node tools/ux4g-conformance/extract-ux4g-tokens.mjs",
    "test": "npm test -w @mosje/design-system && npm test --prefix apps/hub",
    "check:storybook": "node scripts/check-storybook-coverage.mjs",
    "check:storybook:parity": "node scripts/check-storybook-parity.mjs",
    "check:storybook:types": "npm --prefix apps/storybook run typecheck",
    "check:storybook:smoke": "node scripts/smoke-storybook.mjs",
    "check:storybook:baseline": "node scripts/check-storybook-coverage.mjs --update-baseline",
    "ensure:storybook": "node -e \"require('fs').existsSync('apps/hub/public/storybook/index.html')||(console.log('\u2022 building Storybook once into apps/hub/public/storybook\u2026'),process.exit(1))\" || npm run build:storybook --prefix apps/hub",
    "predev:hub": "npm run ensure:storybook",
    "check:color-docs": "node scripts/check-color-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "stylelint": "^16.26.1"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.3.0"
  }
}
