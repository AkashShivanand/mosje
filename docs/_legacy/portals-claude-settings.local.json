{
  "permissions": {
    "allow": [
      "Bash(brew --version)",
      "Bash(curl -s https://api.github.com/repos/cli/cli/releases/latest)",
      "Bash(mkdir -p ~/.local/bin)",
      "Read(//private/tmp/**)",
      "Bash(curl -L -o gh.zip https://github.com/cli/cli/releases/download/v2.92.0/gh_2.92.0_macOS_arm64.zip)",
      "Bash(unzip -q -o gh.zip)",
      "Bash(cp gh_2.92.0_macOS_arm64/bin/gh ~/.local/bin/gh)",
      "Bash(~/.local/bin/gh auth *)",
      "Bash(~/.local/bin/gh repo *)",
      "Bash(npm -v)",
      "Bash(node -v && npm -v && rm -f /tmp/node.pkg)",
      "Bash(npm install *)"
    ]
  }
}
