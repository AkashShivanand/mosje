{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hub",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/hub", "run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "hub-gated",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "SITE_PASSWORD=local-preview exec npm --prefix apps/hub run start -- -p 3001"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/storybook", "run", "dev"],
      "port": 6006,
      "autoPort": false
    }
  ]
}
