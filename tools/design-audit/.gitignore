# per-project runtime artifacts — never commit secrets or heavy captures
projects/*/secrets.json
projects/*/captures/
# `projects/*/out/` as a DIRECTORY exclusion cannot be undone by a negation — git will not
# descend into an excluded directory, so `!projects/*/out/audit-master.json` below would
# silently do nothing. Exclude the CONTENTS instead, then name the two files back in.
projects/*/out/*
!projects/*/out/capture-bundle.json
!projects/*/out/audit-master.json
projects/*/inputs/*.png
node_modules/
__pycache__/
*.pyc
.qc/
report-sections.json

# engine PDF deps are installed locally, never committed (may be a symlink). The lockfile
# goes with them: `npm i` regenerates it on first run, and a machine-specific lockfile is
# not something the audit engine's history needs to carry.
engine/node_modules
engine/package-lock.json

# per-project run logs
projects/*/*.log

# review-sheet working images and the captures symlink are runtime artefacts, like
# captures/ itself — regenerated by build_review_sheet_data.py, not repo history.
projects/*/sheet/*.png
projects/*/sheet/*.json
projects/*/captures

# review-sheet build scratch: downscaled upload copies, the per-batch JS payloads and the
# single-use upload URLs. All regenerated by build_rows.py + the sheet builder.
projects/*/sheet/upload/
# ...and the per-batch payload folders the sheet/report builders write (pins, new rows, boards).
# The pattern above only reaches one level, so these need naming.
projects/*/sheet/*payload/
projects/*/sheet/payload/
projects/*/sheet/rpayload/
projects/*/sheet/urls_*.txt
