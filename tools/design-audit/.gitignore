# per-project runtime artifacts — never commit secrets or heavy captures
projects/*/secrets.json
projects/*/captures/
# `projects/*/out/` as a DIRECTORY exclusion cannot be undone by a negation — git will not
# descend into an excluded directory, so `!projects/*/out/audit-master.json` below would
# silently do nothing. Exclude the CONTENTS instead, then name the two files back in.
projects/*/out/*
!projects/*/out/capture-bundle.json
!projects/*/out/audit-master.json
projects/*/inputs/*.png
node_modules/
__pycache__/
*.pyc
.qc/
report-sections.json

# engine PDF deps are installed locally, never committed (may be a symlink). The lockfile
# goes with them: `npm i` regenerates it on first run, and a machine-specific lockfile is
# not something the audit engine's history needs to carry.
engine/node_modules
engine/package-lock.json

# per-project run logs
projects/*/*.log
