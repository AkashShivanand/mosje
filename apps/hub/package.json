{
  "name": "@mosje/hub",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3007",
    "build": "next build",
    "start": "next start -p 3007",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "ingest": "node scripts/ingest/index.mjs",
    "ingest:verify": "node scripts/ingest/index.mjs --verify-only",
    "ingest:assets": "node scripts/ingest/index.mjs --assets-only",
    "test:ingest": "node --test \"scripts/ingest/**/*.test.mjs\"",
    "test": "node --test \"src/**/*.test.ts\"",
    "build:storybook": "cd ../storybook && npx --no-install storybook build --output-dir ../hub/public/storybook --quiet",
    "prebuild": "npm run build:storybook || echo '::warning:: Storybook build failed \u2014 /storybook will show the unavailable page'"
  },
  "dependencies": {
    "@mosje/design-system": "file:../../packages/design-system",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "fuse.js": "^7.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-live": "^4.1.7",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.8",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "node-html-parser": "^7.1.0",
    "postcss": "^8",
    "sanitize-html": "^2.17.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
